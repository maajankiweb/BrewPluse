# ==============================================================================
# BrewPluse Environment Configuration Template
# ==============================================================================

# 1. MongoDB Database Connection (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/brewpluse?retryWrites=true&w=majority

# 2. Authentication Secret (HMAC-SHA256 Staff Token Signing)
AUTH_SECRET=generate_a_random_32_character_secret_key

# 3. Table QR Ordering & Guest Sessions (Spec Section 11)
GUEST_SESSION_SECRET=generate_a_random_32_character_guest_secret
TABLE_TOKEN_BYTES=9
PENDING_PAYMENT_TTL_MINUTES=15
MAX_ORDER_VALUE_INR=10000

# 4. Email Delivery (SMTP / Nodemailer) for Real Email OTP Dispatch
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="BrewPluse Security" <security@yourdomain.com>

# 5. Environment
NODE_ENV=development
PORT=3000

# 6. Firebase & Cloud Firestore Configuration (Web & Mobile Sync)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 7. Razorpay Payment Gateway & Webhook (Table Online Pay, Setup & Hardware)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
