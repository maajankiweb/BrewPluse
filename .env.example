# ==============================================================================
# BrewPulse Environment Configuration Template
# ==============================================================================

# 1. MongoDB Database Connection (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/brewpluse?retryWrites=true&w=majority

# 2. Authentication Secret (HMAC-SHA256 Token Signing)
AUTH_SECRET=generate_a_random_32_character_secret_key

# 3. Email Delivery (SMTP / Nodemailer) for Real Email OTP Dispatch
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="BrewPulse Security" <security@yourdomain.com>

# 4. Environment
NODE_ENV=development
PORT=3000
