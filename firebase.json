{
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "BrewPluse",
        "authorizedRedirectUris": [
          "https://brewpluse.firebaseapp.com/__/auth/handler",
          "https://brewpluse.netlify.app/__/auth/handler",
          "http://localhost"
        ]
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
